     /// <summary>
     /// Returns a mask of all currently connected controller types.
     /// </summary>
+#if UNITY_EDITOR_LINUX || (UNITY_STANDALONE_LINUX && !UNITY_EDITOR)
+    private static bool GetLinuxOpenVRTracking(Controller controller, UnityEngine.XR.InputTrackingState required)
+    {
+        if (controller != Controller.LTouch && controller != Controller.LHand &&
+            controller != Controller.RTouch && controller != Controller.RHand)
+            return false;
+        var node = (controller == Controller.LTouch || controller == Controller.LHand)
+            ? UnityEngine.XR.XRNode.LeftHand : UnityEngine.XR.XRNode.RightHand;
+        var device = UnityEngine.XR.InputDevices.GetDeviceAtXRNode(node);
+        UnityEngine.XR.InputTrackingState tracking;
+        return device.isValid && device.TryGetFeatureValue(UnityEngine.XR.CommonUsages.trackingState, out tracking)
+            && (tracking & required) == required;
+    }
+#endif
+
     public static Controller GetConnectedControllers()
     {
         return connectedControllerTypes;
