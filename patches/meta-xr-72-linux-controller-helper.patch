+    private static bool IsLinuxOpenVRReady()
+    {
+        if (OVRManager.loadedXRDevice != OVRManager.XRDevice.OpenVR)
+            return false;
+        // The Linux bridge owns OpenVR instead of initializing the native Oculus
+        // manager. Require the real OpenVR display and a Unity XR headset device
+        // before allowing the existing model/UI helper to initialize.
+        if (!UnityEngine.XR.InputDevices.GetDeviceAtXRNode(UnityEngine.XR.XRNode.Head).isValid &&
+            !UnityEngine.XR.InputDevices.GetDeviceAtXRNode(UnityEngine.XR.XRNode.CenterEye).isValid)
+            return false;
+        linuxOpenVRDisplays.Clear();
+        SubsystemManager.GetInstances(linuxOpenVRDisplays);
+        foreach (var display in linuxOpenVRDisplays)
+            if (display.running && display.SubsystemDescriptor.id == "OpenVR Display")
+                return true;
+        return false;
+    }
+#endif
